{
  "name": "glade",
  "version": "0.0.0",
  "private": true,
  "description": "Plan maps and build items for cosy building games",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "dev": "pnpm --parallel --filter @glade/web --filter @glade/server run dev",
    "build": "pnpm --filter @glade/web run build"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@glade/core": "workspace:*",
    "@glade/fixture-profile": "workspace:*",
    "@glade/petit-planet-profile": "workspace:*",
    "@glade/petit-planet-ui": "workspace:*",
    "@glade/render": "workspace:*",
    "@glade/testkit": "workspace:*",
    "@glade/three": "workspace:*",
    "@glade/ui": "workspace:*",
    "@glade/viewport": "workspace:*",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
