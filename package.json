{
  "name": "glade",
  "version": "0.0.0",
  "private": true,
  "description": "Plan maps and build items for cosy building games",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@glade/core": "workspace:*",
    "@glade/fixture-profile": "workspace:*",
    "@glade/petit-planet-profile": "workspace:*",
    "@glade/render": "workspace:*",
    "@glade/testkit": "workspace:*",
    "@glade/three": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
